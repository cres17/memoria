<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 광고(AdMob)를 켠 경우 앱 추적 투명성(ATT)을 요청한다. -->
	<key>NSPrivacyTracking</key>
	<true/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- 앱 자체는 사진·편집 데이터를 기기 밖으로 보내지 않는다. 광고 SDK가 수집하는 항목은 SDK 자체 매니페스트와
	     App Store Connect 개인정보 설문에서 선언한다. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<!-- 앱 코드(Runner)는 사유 선언이 필요한 API(파일 타임스탬프, UserDefaults, 디스크 용량, 시스템 부팅 시간 등)를
	     직접 호출하지 않는다. 플러그인은 각자 매니페스트를 제공한다. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
</dict>
</plist>
